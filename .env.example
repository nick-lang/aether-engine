# Copy to `.env` for local development (`.env` is gitignored).
# Load in the shell before starting the plane, or use your IDE env loader.

# --- Cloud LLM (optional) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Local LLM via Ollama (free, runs on your machine) ---
# Install: https://ollama.com
#   ollama serve
#   ollama list   # use the exact name shown (often includes :latest)
#   ollama pull llama3.2
OLLAMA_URL=http://127.0.0.1:11434
# Small model recommended — plan JSON is tiny (hybrid plan → Rust patch builder)
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECS=120
# Set to 1 to use slow full PatchDocument mode instead of plan → builder
# OLLAMA_LEGACY_PATCH=0
# Studio "Dream" mode: full creative PatchDocument from Ollama (no keyword fallback).
# Use a capable model and generous timeout, e.g. OLLAMA_TIMEOUT_SECS=300

# --- Local image via Ollama (macOS only as of early 2026; use A1111 on Windows) ---
#   ollama pull x/flux2-klein:4b
# OLLAMA_IMAGE_MODEL=x/flux2-klein:4b

# --- Local image via Stable Diffusion WebUI (AUTOMATIC1111) ---
# Start WebUI with --api, default port 7860
A1111_URL=http://127.0.0.1:7860

# --- Content plane ---
# AETHER_PLANE_DATA=data/plane
# AETHER_PLANE_PORT=8787
# AETHER_PLANE_URL=http://127.0.0.1:8787
